# --- dessinsgore.fr - React/Vite sur mutualisé OVH ---
Options -MultiViews -Indexes
RewriteEngine On
RewriteBase /

# HTTPS + suppression du www
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://dessinsgore.fr%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://dessinsgore.fr%{REQUEST_URI} [L,R=301]

# Bloquer les fichiers cachés (.env, .git...)
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Servir directement les fichiers qui existent (assets, images)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Un fichier manquant (.jpg, .js...) donne une vraie 404
RewriteCond %{REQUEST_URI} \.[a-zA-Z0-9]{2,5}$
RewriteRule ^ - [R=404,L]

# Toutes les routes (/galerie, /contact, /xyz...) vont vers React
RewriteRule ^ index.html [L]

ErrorDocument 404 /index.html

<Files "index.html">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>