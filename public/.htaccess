# Application React (Vite) sur OVH / Apache :
# toute adresse qui n'est pas un vrai fichier (ex. /mentions, /galerie)
# renvoie index.html, et c'est React Router qui affiche la bonne page.
# Sans ce fichier, ouvrir directement /mentions donne une erreur 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>